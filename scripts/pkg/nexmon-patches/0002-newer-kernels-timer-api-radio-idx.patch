diff -ruN a/include/nexmon_compat.h b/include/nexmon_compat.h
--- a/include/nexmon_compat.h	1969-12-31 18:00:00.000000000 -0600
+++ b/include/nexmon_compat.h	2026-11-03 17:29:14.626376888 -0600
@@ -0,0 +1,21 @@
+/* Compatibility with newer kernels (Raspberry Pi OS Trixie 6.16+/6.18): renamed timer API, extra radio_idx argument of three cfg80211 ops. */
+#ifndef NEXMON_COMPAT_H
+#define NEXMON_COMPAT_H
+#include <linux/version.h>
+#include <linux/timer.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0)
+#define from_timer(var, callback_timer, timer_fieldname) timer_container_of(var, callback_timer, timer_fieldname)
+#define del_timer_sync timer_delete_sync
+#define del_timer timer_delete
+#endif
+#ifdef NEXMON_RADIO_IDX
+#define NX_RIDX int radio_idx,
+#else
+#define NX_RIDX
+#endif
+#ifdef NEXMON_TXP_LINK_ID
+#define NX_TXP_LINK unsigned int link_id,
+#else
+#define NX_TXP_LINK
+#endif
+#endif
