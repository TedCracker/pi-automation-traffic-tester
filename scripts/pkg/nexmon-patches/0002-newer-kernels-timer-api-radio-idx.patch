diff -ruN a/Makefile b/Makefile
--- a/Makefile	2026-11-03 14:31:29.261073916 -0600
+++ b/Makefile	2026-11-03 17:29:14.627142563 -0600
@@ -39,6 +39,15 @@
 # cfg80211 API detection (see cfg80211.c): newer cfg80211 has .set_monitor_channel(wiphy, netdev, chandef)
 NEXMON_CFG80211_H := $(srctree)/include/net/cfg80211.h
 NEXMON_SETCHAN_NDEV := $(shell grep -A2 'int.*set_monitor_channel' $(NEXMON_CFG80211_H) 2>/dev/null | grep -c 'struct net_device')
+NEXMON_RADIO_IDX_N := $(shell grep -A1 'set_wiphy_params' $(NEXMON_CFG80211_H) 2>/dev/null | grep -c 'radio_idx')
+NEXMON_TXP_LINK_N := $(shell grep -A2 'get_tx_power' $(NEXMON_CFG80211_H) 2>/dev/null | grep -c 'link_id')
+ifneq ($(NEXMON_TXP_LINK_N),0)
+ccflags-y += -DNEXMON_TXP_LINK_ID
+endif
+ifneq ($(NEXMON_RADIO_IDX_N),0)
+ccflags-y += -DNEXMON_RADIO_IDX
+endif
+ccflags-y += -include $(src)/include/nexmon_compat.h
 ifneq ($(NEXMON_SETCHAN_NDEV),0)
 ccflags-y += -DNEXMON_SETCHAN_3ARG
 endif
