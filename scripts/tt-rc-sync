#!/usr/bin/env bash
# Run by systemd (root) whenever the app changes <data>/claude/state.json: start or stop the Remote Control service to match.
# The web app never gets any privilege for this: it only writes its wish into state.json. This script can do exactly one thing:
# start or stop traffic-tester-claude-rc.service.
set -u
BASE="${TT_CLAUDE_BASE:-/var/lib/traffic-tester/claude}"
SYSTEMCTL="${TT_SYSTEMCTL:-systemctl}"
UNIT=traffic-tester-claude-rc.service
if python3 - "$BASE/state.json" <<'PY'
import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
sys.exit(0 if d.get("enabled") and d.get("remote_control") else 1)
PY
then "$SYSTEMCTL" start "$UNIT"; else "$SYSTEMCTL" stop "$UNIT"; fi
