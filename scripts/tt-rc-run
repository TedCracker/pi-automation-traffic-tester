#!/usr/bin/env bash
# Runs `claude remote-control` inside a tmux session (it wants a terminal) for the systemd unit. Answers the two one-time questions
# (enable Remote Control / trust this folder) because this is his own app folder. Exits (so systemd restarts it) if the session ends,
# and does not start at all unless Claude Code AND Remote Control are switched on in state.json.
set -u
BASE="${TT_CLAUDE_BASE:-/var/lib/traffic-tester/claude}"
SOCK="${TT_RC_SOCK:-/run/traffic-tester-rc/rc.tmux}"
CLAUDE="${TT_CLAUDE_BIN:-$(command -v claude || echo /usr/bin/claude)}"
NAME="Pi Automation Traffic Tester $(hostname)"
wanted() { python3 - "$BASE/state.json" <<'PY'
import json, sys
try: d = json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
sys.exit(0 if d.get("enabled") and d.get("remote_control") else 1)
PY
}
wanted || { echo "Claude Code / Remote Control is off: not starting" >&2; exit 0; }
mkdir -p "$(dirname "$SOCK")"
tmux -S "$SOCK" kill-session -t rc 2>/dev/null || true
tmux -S "$SOCK" new-session -d -s rc -c "$BASE/work" "env HOME='$BASE/home' CLAUDE_CONFIG_DIR='$BASE/config' DISABLE_AUTOUPDATER=1 '$CLAUDE' remote-control --name '$NAME' --capacity 1"
for _ in $(seq 1 40); do
  sleep 1
  tmux -S "$SOCK" has-session -t rc 2>/dev/null || { echo "Remote Control ended" >&2; exit 1; }
  screen="$(tmux -S "$SOCK" capture-pane -p -t rc 2>/dev/null || true)"
  echo "$screen" | grep -q 'Enable Remote Control?' && tmux -S "$SOCK" send-keys -t rc y Enter
  echo "$screen" | grep -qE 'Trust .*\[y/N\]' && tmux -S "$SOCK" send-keys -t rc y Enter
done
while tmux -S "$SOCK" has-session -t rc 2>/dev/null; do
  wanted || { tmux -S "$SOCK" kill-session -t rc; exit 0; }     # switched off (log-out / Stop button): stop within seconds, even if nothing else tells us
  sleep 5
done
exit 1
